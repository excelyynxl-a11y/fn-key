# Optional overrides; Compose works with these defaults without an .env file.
PORT=5000
CLIENT_PORT=5173
MONGO_URI=mongodb://mongodb:27017/<ur_stringur_api_key>
CLIENT_ORIGIN=http://localhost:5173
# Browser-facing URL: Docker service names are not resolvable by the browser.
VITE_API_URL=http://localhost:5000
WATCH_USE_POLLING=true

# Optional: used only for unresolved classification, document-role, or field fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_ATTEMPTS=3
OPENAI_TIMEOUT_MS=20000
