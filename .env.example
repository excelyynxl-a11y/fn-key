# Copy this file to .env and replace the MongoDB placeholder. Never commit real secrets.
PORT=5000
CLIENT_PORT=5173
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
# Comma-separated exact browser origins; wildcards are not accepted.
CLIENT_ORIGIN=http://localhost:5173
# Browser-facing URL: Docker service names are not resolvable by the browser.
VITE_API_URL=http://localhost:5000
WATCH_USE_POLLING=true

# Optional: used only for unresolved classification, document-role, or field fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_ATTEMPTS=3
OPENAI_TIMEOUT_MS=20000
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_MAXIMUM=300
API_RATE_LIMIT_WINDOW_MS=60000
# Optional pricing inputs used only for estimated run-cost metrics.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
